{
  "buildroot": "~/dev/buildroot",
  "seed": "~/dev/linux",
  "state": "~/.local/state/kernel-ci",
  "upstream": "https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git",
  "targets": [
    {
      "build": "arm64/rpi4-b",
      "target": "rpi4",
      "mode": "aarch64",
      "tftp_images": [
        "rpi-boot/upstream/kernel8.img",
        "rpi-boot/upstream/bcm2711-rpi-4-b.dtb"
      ]
    },
    {
      "build": "arm/rpi4-b",
      "target": "rpi4",
      "mode": "arm",
      "tftp_images": [
        "rpi-boot/upstream/kernel7.img",
        "rpi-boot/upstream/bcm2711-rpi-4-b.dtb"
      ]
    },
    {
      "build": "arm/ns",
      "target": "smartrg",
      "mode": "arm",
      "tftp_images": [
        "zImage.bcm4708-smartrg-sr400ac"
      ]
    },
    {
      "build": "mips64/cobalt",
      "target": "qube2",
      "mode": "mips64",
      "tftp_images": [
        "cobalt/vmlinux64"
      ]
    },
    {
      "build": "mips64/sibyte",
      "target": "sibyte",
      "mode": "mips64",
      "tftp_images": [
        "sibyte/vmlinux.32"
      ]
    },
    {
      "build": "mips/cobalt",
      "target": "qube2",
      "mode": "mips32",
      "tftp_images": [
        "cobalt/vmlinux32"
      ]
    },
    {
      "build": "mips/mtx1",
      "target": "mtx1",
      "mode": "mips32",
      "tftp_images": [
        "mtx1/vmlinux.srec"
      ]
    },
    {
      "build": "mips/ci20",
      "target": "ci20",
      "mode": "mips32",
      "tftp_images": [
        "ci20/uImage"
      ]
    },
    {
      "build": "x86/rdc"
    },
    {
      "build": "arm/ea4500",
      "target": "ea4500",
      "mode": "arm",
      "tftp_images": [
        "tftp/e4500/uImage"
      ]
    },
    {
      "build": "arm/lamobo-r1",
      "target": "lamobo-r1",
      "mode": "arm",
      "tftp_images": [
        "lamobo-r1/zImage",
        "lamobo-r1/sun7i-a20-lamobo-r1.dtb"
      ]
    }
  ],
  "labgrid": "~/dev/github/labgrid",
  "labgrid_python": "~/dev/github/labgrid/.venv/bin/python",
  "labgrid_environments": "~/dev/labgrid-local",
  "tftp_root": "/srv/tftp",
  "boot_timeout": 600
}
